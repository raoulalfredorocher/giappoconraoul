rules_version = '2';
// Solo l'utente autenticato legge e scrive i propri dati (users/{uid}/hiragana/japan). Tutto il resto è negato.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/hiragana/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
